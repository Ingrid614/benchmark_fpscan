/*
 * Suite de Muller.
 * Ce benchmark étudie la convergence de la suite :
 *
 * u(n) = 111 - 1130/u(n-1) + 3000/(u(n-2)*u(n-1))
 *
 * La limite théorique est 6, mais les erreurs d'arrondi
 * peuvent progressivement faire dévier la suite.
 * 
 * Pour la réécriture nous avons reduit au meme denominateur les deux derniers termes de l'expression :
 * Nous avons transformé : 111. - 1130. / un_2 + 3000. / (un_1 * un_2)
 * en : 111. + (3000. - 1130. * un_1) / (un_1 * un_2)
 *
 * Avant : 2 Cancellations; 0 Absorptions (avec -unroll_n 3)
 * Après : 1 Cancellations; 0 Absorptions (avec -unroll_n 3)
 */
 
double un_1;
float un_1_cast;
float un_2;
float un_3;
float i;

/* u1 = 11/2 */
un_1 = 5.5;

/* u2 = 61/11 */
un_2 = 61.0 / 11.0;

/* on commence au calcul de u3 */
i = 3.0;
while (i <= 25.)
{
    /* sauvegarde de u(n-1) */
    un_3 = un_2;

    /* calcul de u(n) */
    un_1_cast = cast(float,un_1);
    un_2 = 111.0 + (3000.0 - 1130.0 * un_1) / (un_1_cast * un_2);

    /* décalage des termes */
    un_1_cast = un_3;

    i = i + 1.;
}

