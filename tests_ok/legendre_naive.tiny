/*
 * Polynôme de Legendre P20
 * Evaluation naïve.
 *
 * Les coefficients sont conservés sous forme de divisions
 * afin de reproduire les opérations flottantes du benchmark
 * d'origine.
 */

float x;

float x2;
float x4;
float x6;
float x8;
float x10;
float x12;
float x14;
float x16;
float x18;
float x20;

float c0;
float c2;
float c4;
float c6;
float c8;
float c10;
float c12;
float c14;
float c16;
float c18;
float c20;

float r;
float val;

val = 0.999;
x = val;

/* puissances */

x2 = x * x;
x4 = x2 * x2;
x6 = x4 * x2;
x8 = x4 * x4;
x10 = x8 * x2;
x12 = x10 * x2;
x14 = x12 * x2;
x16 = x8 * x8;
x18 = x16 * x2;
x20 = x10 * x10;

/* coefficients du polynôme */

c20 = 34461632205. / 262144.;
c18 = -83945001525. / 131072.;
c16 = 347123925225. / 262144.;
c14 = -49589132175. / 32768.;
c12 = 136745788725. / 131072.;
c10 = -29113619535. / 65536.;
c8  = 15058768725. / 131072.;
c6  = -557732175. / 32768.;
c4  = 334639305. / 262144.;
c2  = -4849845. / 131072.;
c0  = 46189. / 262144.;

/* évaluation naïve */

r =
    c20 * x20
  + c18 * x18
  + c16 * x16
  + c14 * x14
  + c12 * x12
  + c10 * x10
  + c8  * x8
  + c6  * x6
  + c4  * x4
  + c2  * x2
  + c0;