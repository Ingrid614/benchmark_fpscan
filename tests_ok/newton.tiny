/*
 * Méthode de Newton-Raphson pour trouver une racine du polynôme :
 *
 * f(x) = 1.47*x*x*x + 1.19*x*x - 1.83*x + 0.45
 *
 * La mise à jour est :
 *
 * y = x - f(x)/f'(x)
 *
 * avec :
 *
 * f'(x) = 4.41*x*x + 2.38*x - 1.83
 */

float eps;
float nmax;

float i;

float x;
float y;
float coef1;
float coef2;
float coef3;
float coef4;
float coef5;
float coef6;
float coef7;
float deux;

coef1 = 1.47;
coef2 = 1.19;
coef3 = 1.83;
coef4 = 0.45;
coef5 = 4.41;
coef6 = 2.38;
coef7 = 1.83;
deux = 2.;
eps = 0.000000000001;
nmax = 3.;

i = 1.;

y = 0.5;
x = y + 2. * eps;

while (i < nmax)
{
    x = y;

    y = x - (((coef1 * x * x * x + coef2 * x * x) - coef3 * x + coef4)
            /
            (coef5 * x * x + coef6 * x - coef7));

    i = i + 1.;
}