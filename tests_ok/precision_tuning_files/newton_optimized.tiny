/*
 * Méthode de Newton-Raphson pour trouver une racine du polynôme :
 *
 * f(x) = 1.47*x*x*x + 1.19*x*x - 1.83*x + 0.45
 *
 * La mise à jour est :
 *
 * y = x - f(x)/f'(x)
 *
 * avec :
 *
 * f'(x) = 4.41*x*x + 2.38*x - 1.83
 *
 * Une reécriture du numérateur et du dénominateur a été faite en mettant x en facteur dans l'expression
 * f(x) = (((x * 1.47 + 1.19) * x - 1.83) * x + 0.45)
 * f'(x) = ((x * 4.41 + 2.38) * x - 1.83)
 * Avant : 5 Cancellations; 1 Absorptions (unroll_n 3)
 * Après : 4 Cancellations; 1 Absorptions
 */

float eps;
double eps_cast;
float nmax;
double nmax_cast;

double i;

double x;
double y;

eps = 0.000000000001;
nmax = 3.;

i = 1.;

y = 0.5;
eps_cast = cast(double,eps);
x = y + 2. * eps_cast;

nmax_cast = cast(double,nmax);
while (i < nmax_cast)
{
    x = y;

    y =
        x
        -
        (
            (((x * 1.47 + 1.19) * x - 1.83) * x + 0.45)
            /
            ((x * 4.41 + 2.38) * x - 1.83)
        );

    i = i + 1.;
}