/*
 * Evaluation du polynôme 5*x*x - 3
 * pour des valeurs de x très proches de sa racine sqrt(3/5).
 *
 * Ce benchmark étudie les erreurs d'arrondi
 * lorsque le résultat est proche de zéro.
 */
double x1;  float y1;
double x2;  float y2;
double x3;  float y3;
double x4;  float y4;
double x5;  float y5;
double x6;  float y6;
double x7;  float y7;
double x8;  float y8;
double x9;  float y9;
double x10; float y10;
double x11; float y11;
double x12; float y12;
double inter1,inter2,inter3,inter4,inter5,inter6,inter7,inter8,inter9,inter10,inter11,inter12;


x1  = 0.7745966692414830;
x2  = 0.7745966692414831;
x3  = 0.7745966692414832;
x4  = 0.7745966692414833;
x5  = 0.7745966692414834;
x6  = 0.7745966692414835;
x7  = 0.7745966692414836;
x8  = 0.7745966692414837;
x9  = 0.7745966692414838;
x10 = 0.7745966692414840;
x11 = 0.7745966692414841;
x12 = 0.7745966692414842;


inter1 = 5. * x1 * x1  - 3.;
y1  = cast(float,inter1);
inter2 = 5. * x2 * x2  - 3.;
y2  = cast(float,inter2);
inter3 = 5. * x3 * x3  - 3.;
y3  = cast(float,inter3);
inter4 = 5. * x4 * x4  - 3.;
y4  = cast(float,inter4);
inter5 = 5. * x5 * x5  - 3.;
y5  = cast(float,inter5);
inter6 = 5. * x6 * x6  - 3.;
y6  = cast(float,inter6);
inter7 = 5. * x7 * x7  - 3.;
y7  = cast(float,inter7);
inter8 = 5. * x8 * x8  - 3.;
y8  = cast(float,inter8);
inter9 = 5. * x9 * x9  - 3.;
y9  = cast(float,inter9);
inter10 = 5. * x10 * x10  - 3.;
y10  = cast(float,inter10);
inter11 = 5. * x11 * x11  - 3.;
y11  = cast(float,inter11);
inter12 = 5. * x12 * x12  - 3.;
y12  = cast(float,inter12);