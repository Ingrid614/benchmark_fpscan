/*
 * Résolution d'une équation quadratique :
 *
 * a*x*x + b*x + c = 0
 *
 * avec la formule classique :
 *
 * x = (-b +/- sqrt(b*b - 4*a*c))/(2*a)
 *
 * Exemple inspiré de Kahan :
 * "A Survey of Error Analysis".
 *
 * Ce benchmark étudie une cancellation
 * dans le calcul du discriminant :
 *
 *     b*b - 4*a*c
 *
 */

double fa;
float fa_cast;
double fb;
float fb_cast;
double fc;

double fbb;
double f4ac;

float sub;
double sub_cast;
float fsqt;

float numer1;
float numer2;

float root1;
float root2;


/* coefficients */

fa = 7169.;
fb = -8686.;
fc = 2631.;


/* calcul du discriminant */

fbb = fb * fb;


f4ac = 4. * fa * fc;

sub_cast = fbb - f4ac;


/* racine du discriminant */
sub = cast(float,sub_cast);
fsqt = sqrt(sub);


/* numérateurs */

fb_cast = cast(float,fb);
numer1 = (-1. * fb_cast) + fsqt;


numer2 = (-1. * fb_cast) - fsqt;


/* racines */
fa_cast = cast(float,fa);
root1 = numer1 / (2. * fa_cast);


root2 = numer2 / (2. * fa_cast);