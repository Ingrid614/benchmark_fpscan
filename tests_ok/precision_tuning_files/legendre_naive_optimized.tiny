/*
 * Essai de réparation du benchmark sur le Polynôme de Legendre P20
 * Evaluation naïve.
 *
 * Les coefficients sont conservés sous forme de divisions
 * afin de reproduire les opérations flottantes du benchmark
 * d'origine.
 * L'outil Odyssey nous a proposé une réécriture avec 70.6% de précision dans l'intervalle [0,999 ; 1] et 53.6% sur R 
 * Contre 66.9% dans l'intervalle [0,999 ; 1] et 52.6% sur R
 * Avant : 4 Cancellations; 1 Absorptions
 * Après : 3 Cancellations; 0 Absorptions
 */

double x;

double x2;
double x4;
double x6;
double x8;
double x10;
double x12;
double x14;
double x16;
double x18;
double x20;

f_10_5 c0;
float c2;
float c4;
double c0_cast;
double c2_cast;
double c4_cast;
double c6;
double c8;
double c10;
double c12;
double c14;
double c16;
double c18;
double c20; // float initialement

float r;
double r_cast;


x = 0.999;

/* puissances */

x2 = x * x;
x4 = x2 * x2;
x6 = x4 * x2;
x8 = x4 * x4;
x10 = x8 * x2;
x12 = x10 * x2;
x14 = x12 * x2;
x16 = x8 * x8;
x18 = x16 * x2;
x20 = x10 * x10;

/* coefficients du polynôme */

c20 = 34461632205. / 262144.;
c18 = -83945001525. / 131072.;
c16 = 347123925225. / 262144.;
c14 = -49589132175. / 32768.;
c12 = 136745788725. / 131072.;
c10 = -29113619535. / 65536.;
c8  = 15058768725. / 131072.;
c6  = -557732175. / 32768.;
c4  = 334639305. / 262144.;
c2  = -4849845. / 131072.;
c0  = 46189. / 262144.;

c0_cast = cast(double,c0);
c2_cast = cast(double,c2);
c4_cast = cast(double,c4);
r_cast = cast(double,r);
/* évaluation naïve */

