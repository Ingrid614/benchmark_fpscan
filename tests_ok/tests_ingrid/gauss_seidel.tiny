/* Benchmark : Gauss-Seidel pour système linéaire */
/* Problème : cancellation dans la mise à jour */

float x1, x2, x3;
float a11, a12, a13, b1;
float N, i, somme;

N = 100000.0;
i = 0.0;
x1 = 0.0;
x2 = 0.0;
x3 = 0.0;

/* Système mal conditionné */
a11 = 1000000000000.0;
a12 = 1000000000000.0 - 1.0;
a13 = 1000000000000.0 - 2.0;
b1 = 3000000000000.0;

while (i < N) {
    /* Mise à jour de x1 */
    somme = a12 * x2 + a13 * x3;

    x1 = (b1 - somme) / a11;

    /* Variation des coefficients */
    a12 = 1000000000000.0 - 1.0 + sin(1000.0 * i);

    i = i + 1.0;
}