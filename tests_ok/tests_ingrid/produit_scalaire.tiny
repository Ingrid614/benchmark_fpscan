/* Benchmark : Produit scalaire avec cancellation */
/* Les termes s'annulent entre eux */

float x1, x2, x3, x4;
float y1, y2, y3, y4;
float produit_scalaire;

/* Vecteur x*/
x1 = 1250.3847;
x2 = -837.2163;
x3 = 492.7518;
x4 = 1031.4286;

/* Vecteur y */

y1 = 1250.3846;
y2 = 837.2162;
y3 = -492.7517;
y4 = 1031.4285;

produit_scalaire = x1*y1 + x2*y2 + x3*y3 + x4*y4;