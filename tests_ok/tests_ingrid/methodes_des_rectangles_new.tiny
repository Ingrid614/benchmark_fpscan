/*
 * Approximation de l'intégrale de sin(x) sur [a, b]
 * à l'aide des sommes de Riemann inférieure et supérieure.
 *
 * Version déroulée sur trois itérations.
 */

float a;
float b;
float n;

float longueur;

float aire_inf;
float aire_sup;

float x1;
float x2;

float s1;
float s2;


/* Bornes */

a = 0.0;
b = 6.283185307179586;
n = 100.0;

longueur = (b - a) / n;

/* Initialisation */

aire_inf = 0.0;
aire_sup = 0.0;

/**********************/
/* Itération k = 0    */
/**********************/

x1 = a;
x2 = a + longueur;

s1 = sin(1000.0 * x1);
s2 = sin(1000.0 * x2);

aire_inf = aire_inf + longueur * s1;
aire_sup = aire_sup + longueur * s2;

/**********************/
/* Itération k = 1    */
/**********************/

x1 = a + longueur;
x2 = a + 2.0 * longueur;

s1 = sin(1000.0 * x1);
s2 = sin(1000.0 * x2);

aire_inf = aire_inf + longueur * s1;
aire_sup = aire_sup + longueur * s2;

/**********************/
/* Itération k = 2    */
/**********************/

x1 = a + 2.0 * longueur;
x2 = a + 3.0 * longueur;

s1 = sin(1000.0 * x1);
s2 = sin(1000.0 * x2);

aire_inf = aire_inf + longueur * s1;
aire_sup = aire_sup + longueur * s2;