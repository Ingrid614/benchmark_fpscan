/*
 * Orthogonalisation de Gram-Schmidt classique.
 *
 * Ce benchmark calcule la projection d'un vecteur sur un
 * premier vecteur afin d'obtenir une composante orthogonal
 *
 */
float a11;
float a12;
float a13;

float a21;
float a22;
float a23;

float dot;
float norm;

float v21;
float v22;
float v23;

a11 = 100000000.0;     
a12 = 2.0;
a13 = 1.0;

a21 = 100000000.0;    
a22 = 1.123456;
a23 = 2.0;

/* norme² */

norm = a11*a11 + a12*a12 + a13*a13;

/* produit scalaire */

dot = a21*a11 + a22*a12 + a23*a13;     

/* projection */

v21 = a21 - dot*a11/norm;
v22 = a22 - dot*a12/norm;
v23 = a23 - dot*a13/norm;