/* Benchmark : Méthode de la sécante */
/* Problème : cancellation dans f(x1) - f(x0) */

float x0, x1, x2;
float f_x0, f_x1, f_x2;
float N, i, denominateur;

N = 100000.0;
i = 0.0;
x0 = 1000000.0;
x1 = 1000000.0 + 0.000001;

while (i < N) {
    f_x0 = x0 * x0 - 1000000000000.0;
    f_x1 = x1 * x1 - 1000000000000.0;

    denominateur = f_x1 - f_x0;

    x2 = x1 - f_x1 * (x1 - x0) / denominateur;

    x0 = x1;
    x1 = x2;

    x1 = x0 + 0.000001 * sin(5000.0 * i);

    i = i + 1.0;
}