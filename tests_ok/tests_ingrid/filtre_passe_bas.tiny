/* Benchmark : Filtre passe-bas récurrent */
/* Problème : absorption des petites variations */

float y_prev, y, x;
float alpha;
float N, i;

N = 100000.0;
i = 0.0;
y_prev = 1000000000000000.0;
alpha = 0.00000001;  /* Constante de temps très lente */

while (i < N) {
    /* Signal lentement variable */
    x = 1000000000000000.0 + 100.0 * sin(1000.0 * i);

    /* Filtre passe-bas : y = alpha*x + (1-alpha)*y_prev */
    y = alpha * x + (1.0 - alpha) * y_prev;

    y_prev = y;

    i = i + 1.0;
}