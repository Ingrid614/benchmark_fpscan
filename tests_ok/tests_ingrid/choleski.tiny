/* Version sans boucle : une seule itération */

/* Paramètres */

float eps;
float big;

float diff;
float sum;

/* Facteur de Cholesky */

float l11;
float l21;
float l22;
float l31;
float l32;
float l33;

/* Matrice */

float a11;
float a12;
float a13;

float a21;
float a22;
float a23;

float a31;
float a32;
float a33;

eps = 0.000000000000001;
big = 1000000.0;
a11 = cast(float,rand_real(1.0,2.0));

/* Matrice de Hilbert */

a12 = big * 0.5;
a13 = big * 0.3333333333;

a21 = big * 0.5;
a22 = big * 0.3333333333;
a23 = big * 0.25;

a31 = big * 0.3333333333;
a32 = big * 0.25;
a33 = big * 0.2;

/************* Cholesky *************/

l11 = sqrt(a11);

l21 = a21 / l11;
l31 = a31 / l11;

/* Colonne 2 */

sum = a22;
sum = sum - (l21 * l21);

/* sin(0)=0 */

sum = sum + eps * 0.0 * big;

l22 = sqrt(sum);

/* Colonne 3 */

sum = a32;
sum = sum - (l31 * l21);

/* cos(0)=1 */

sum = sum + eps * 1.0 * big;

l32 = sum / l22;

/* Dernière diagonale */

sum = a33;
sum = sum - (l31 * l31);
sum = sum - (l32 * l32);

/* sin(42) */

sum = sum + eps * sin(42.0) * big;

l33 = sqrt(sum);

/************* Vérification *************/

sum = l33 * l33;

diff = a33;
diff = diff - (l31 * l31);
diff = diff - (l32 * l32);
diff = diff - sum;

/* sin(0)=0 */

diff = diff * big * 0.000001 * 0.0;