/*
 * Résolution d'un système Ax = b par Cholesky.
 *
 * La matrice A est supposée déjà factorisée :
 *
 *      A = L L^T
 *
 * Ce benchmark ne réalise que :
 *   1) la substitution avant  Ly = b
 *   2) la substitution arrière L^T x = y
 *
 */

float L00;
float L10;
float L11;
float L20;
float L21;
float L22;
float L30;
float L31;
float L32;
float L33;

float b0;
float b1;
float b2;
float b3;

float y0;
float y1;
float y2;
float y3;

float x0;
float x1;
float x2;
float x3;

float sum;

/* L */

L00 = 100000000.0;

L10 = 99999999.0;
L11 = 1.0;

L20 = 99999998.0;
L21 = 1.0;
L22 = 0.0001;

L30 = 99999997.0;
L31 = 1.0;
L32 = 0.0001;
L33 = 0.00000001;

/* b */

b0 = 100000000.0;

b1 = 99999999.000001;

b2 = 99999998.000002;

b3 = 99999997.000003;

/**********************/
/* Substitution avant */
/**********************/

sum = 0.0;
y0 = b0 / L00;

sum = L10 * y0;
y1 = (b1 - sum) / L11;

sum = L20 * y0;
sum = sum + L21 * y1;
y2 = (b2 - sum) / L22;

sum = L30 * y0;
sum = sum + L31 * y1;
sum = sum + L32 * y2;
y3 = (b3 - sum) / L33;

/***********************/
/* Substitution arrière */
/***********************/

sum = 0.0;
x3 = y3 / L33;

sum = L32 * x3;
x2 = (y2 - sum) / L22;

sum = L21 * x2;
sum = sum + L31 * x3;
x1 = (y1 - sum) / L11;

sum = L10 * x1;
sum = sum + L20 * x2;
sum = sum + L30 * x3;
x0 = (y0 - sum) / L00;