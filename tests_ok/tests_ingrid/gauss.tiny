float A00;
float A01;
float A02;

float A10;
float A11;
float A12;

float A20;
float A21;
float A22;

float b0;
float b1;
float b2;

float m;

/* matrice */

A00 = 100000000.0;
A01 = 100000000.0;
A02 = 100000000.0;

A10 = 100000000.0;
A11 = 100000000.0000001;
A12 = 100000000.0;

A20 = 100000000.0;
A21 = 100000000.0;
A22 = 100000000.000001;

/* second membre */

b0 = 3.;
b1 = 3.000001;
b2 = 3.000001;

/******** Elimination ********/

m = A10/A00;

A11 = A11 - m*A01;
A12 = A12 - m*A02;
b1 = b1 - m*b0;

m = A20/A00;

A21 = A21 - m*A01;
A22 = A22 - m*A02;
b2 = b2 - m*b0;

m = A21/A11;

A22 = A22 - m*A12;
b2 = b2 - m*b1;