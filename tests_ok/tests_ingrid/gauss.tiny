float A00;
float A01;
float A02;

float A10;
float A11;
float A12;

float A20;
float A21;
float A22;

float b0;
float b1;
float b2;

float m;
float m_cast;

/* matrice */

A00 = 100000000.0;
A01 = 100000000.0;
A02 = 100000000.00000001;   

A10 = 100000000.0;
A11 = 100000000.002;   
A12 = 100000000.0;

A20 = 100000000.0;
A21 = 100000000.0;
A22 = 0.0000001;             

/* second membre */

b0 = 3.0;
b1 = 3.00000001;             
b2 = 0.00000001;              

/******** Elimination ********/

m = 1.;    // A10/A00             

A11 = A11 - m*A01;           
A12 = A12 - m*A02;           
b1  = b1  - m*b0;            

m = 1.; // A20/A00                 

A21 = A21 - m*A01;           
A22 = A22 - m*A02;           
b2  = b2  - m*b0;            

m = A21/A11;

A22 = A22 - m*A12;          
b2  = b2  - m*b1;           