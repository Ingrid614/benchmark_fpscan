/* Benchmark : Méthode de la puissance déroulée */
/* Matrice 3x3, une seule boucle while */

float x1, x2, x3;      /* Vecteur courant */
float y1, y2, y3;      /* Vecteur après multiplication */
float lambda;
float N, i;
float a11;
float a12;
float a13;
float a21;
float a22;
float a23;
float a31;
float a32;
float a33;

float numerateur;
float denominateur;
float norme;


/* Initialisation */
N = 100000.0;
i = 0.0;

/* Vecteur initial */
x1 = 1.0;
x2 = 0.0;
x3 = 0.0;

a11 = 1000000000000.0;
a12 = 1000000000001.0;
a13 = 1000000000002.0;
a21 = 1000000000003.0;
a22 = 1000000000004.0;
a23 = 1000000000005.0;
a31 = 1000000000006.0;
a32 = 1000000000007.0;
a33 = 1000000000008.0;

while (i < N) {
    y1 = a11 * x1 + a12 * x2 + a13 * x3;

    y2 = a21 * x1 + a22 * x2 + a23 * x3;
    y3 = a31 * x1 + a32 * x2 + a33 * x3;

    numerateur = y1 * x1 + y2 * x2 + y3 * x3;
    denominateur = x1 * x1 + x2 * x2 + x3 * x3;
    lambda = numerateur / denominateur;

    /* Normalisation du vecteur pour éviter l'overflow */
    norme = sqrt(denominateur);
    x1 = y1 / norme;
    x2 = y2 / norme;
    x3 = y3 / norme;

    /* Variation des coefficients pour créer différents cas */
    a11 = 1000000000000.0 + 1000000.0 * sin(1000.0 * i);
    a12 = 1000000000000.0 - 1.0 + 1000000.0 * cos(2000.0 * i);
    a13 = 1000000000000.0 - 2.0 + 1000000.0 * sin(3000.0 * i);
    a21 = 1000000000000.0 - 3.0 + 1000000.0 * cos(4000.0 * i);
    a22 = 1000000000000.0 - 4.0 + 1000000.0 * sin(5000.0 * i);
    a23 = 1000000000000.0 - 5.0 + 1000000.0 * cos(6000.0 * i);
    a31 = 1000000000000.0 - 6.0 + 1000000.0 * sin(7000.0 * i);
    a32 = 1000000000000.0 - 7.0 + 1000000.0 * cos(8000.0 * i);
    a33 = 1000000000000.0 - 8.0 + 1000000.0 * sin(9000.0 * i);

    /* Variation du vecteur initial */
    x1 = 1.0 + 0.000001 * sin(11000.0 * i);
    x2 = 0.000001 * cos(12000.0 * i);
    x3 = 0.000001 * sin(13000.0 * i);

    i = i + 1.0;
}