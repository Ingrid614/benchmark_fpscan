/*
 * Benchmark : résolution d'un système linéaire par Gauss-Seidel.
 *
 * La méthode de Gauss-Seidel met à jour immédiatement chaque
 * nouvelle composante de la solution.
 */


/* Variables de la solution */
float x1;
float x2;
float x3;

/* Coefficients de la matrice A */
float a11;
float a12;
float a13;

float a21;
float a22;
float a23;

float a31;
float a32;
float a33;

/* Second membre */
float b1;
float b2;
float b3;

/* Variables temporaires */
float somme;
float i;
float N;


/* Nombre d'itérations */
N = 20.0;
i = 0.0;


/* Initialisation de la solution */
x1 = 0.0;
x2 = 0.0;
x3 = 0.0;


/*
 * Matrice du système.
 *
 * Les coefficients 1e8 rendent les produits importants.
 * Les coefficients 1e-2 introduisent des termes beaucoup
 * plus petits susceptibles d'être absorbés.
 */

a11 = 300000000.0;
a12 = 100000000.0;
a13 = 0.01;

a21 = 100000000.0;
a22 = 300000000.0;
a23 = 0.01;

a31 = 0.01;
a32 = 0.01;
a33 = 1.0;


/*
 * Second membre.
 *
 * Les valeurs sont choisies de manière à ce que certaines
 * soustractions b - somme produisent une petite différence
 * entre deux nombres relativement grands.
 */

b1 = 100000300.01;
b2 = 400000000.01;
b3 = 1.02000001;


while (i < N)
{

    somme = a12 * x2;
    somme = somme + a13 * x3;

    x1 = (b1 - somme) / a11;



    somme = a21 * x1;
    somme = somme + a23 * x3;

    x2 = (b2 - somme) / a22;


    somme = a31 * x1;
    somme = somme + a32 * x2;

    x3 = (b3 - somme) / a33;


    i = i + 1.0;
}